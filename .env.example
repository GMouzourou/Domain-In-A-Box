# Copy this file to `.env` and adjust for your environment before running `make dev-up`.

DIB_REALM=DOMAIN.HOME.ARPA
DIB_DOMAIN=DOMAIN
# Set each password to a unique value before starting the stack.
DIB_DOMAIN_ADMIN_PASSWORD=
DIB_LDAP_PASSWORD=
STORK_DATABASE_PASSWORD=
DIB_SYNC_DOMAIN_ADMIN_PASSWORD_ON_RESTART=false

DIB_INTERFACE=eth0
DIB_DHCP_POOL=192.168.1.100-192.168.1.199
DIB_DNS_FORWARDERS=1.1.1.1; 8.8.8.8;
DIB_SAMBA_METRICS_ENABLED=true
DIB_SAMBA_METRICS_PORT=9922

# Stork HTTPS and LDAPS require certificates; see the README for expected files and SANs.
# Defaults match the bind mounts in docker-compose.yml.
DIB_CONTROLLER_TLS_DIR=./certs/controller
DIB_STORK_SERVER_TLS_DIR=./certs/stork-server
DIB_POSTGRES_TLS_DIR=./certs/postgresql

# Optional external PostgreSQL settings. External connections require verified TLS.
# DIB_STORK_DATABASE_EXTERNAL=true
# STORK_DATABASE_HOST=postgres.example.com
# STORK_DATABASE_PORT=5432
# STORK_DATABASE_NAME=stork
# STORK_DATABASE_USER_NAME=stork
# STORK_DATABASE_SSLMODE=verify-full
# STORK_DATABASE_SSLROOTCERT=/etc/stork/postgresql-tls/ca.crt
