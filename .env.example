# Copy this file to `.env` and adjust for your environment before running `make dev-up`.

DIB_REALM=DOMAIN.HOME.ARPA
# Optional NetBIOS domain name; empty uses the realm's first label.
DIB_DOMAIN=
# Domain Administrator password. It reaches the controller as a Compose secret.
DIB_DOMAIN_ADMIN_PASSWORD=
# Optional service passwords. Empty values are generated once and kept in the
# dib-secrets volume; set them only to use your own values.
DIB_LDAP_PASSWORD=
STORK_DATABASE_PASSWORD=
DIB_SYNC_DOMAIN_ADMIN_PASSWORD_ON_RESTART=false
# Compatibility escape hatch only; normal Compose uses explicit capabilities.
DIB_PRIVILEGED=false

# Host interface on your LAN, used as the macvlan parent.
DIB_PARENT_INTERFACE=eth0
# LAN subnet and gateway, and the addresses of the controller and the Stork web UI.
DIB_LAN_SUBNET=192.168.1.0/24
DIB_LAN_GATEWAY=192.168.1.254
DIB_CONTROLLER_IP=192.168.1.1
DIB_STORK_IP=192.168.1.3
# Interface inside the controller container; eth0 is the preferred LAN network.
DIB_INTERFACE=eth0
DIB_DHCP_POOL=192.168.1.100-192.168.1.199
DIB_DNS_FORWARDERS=1.1.1.1; 8.8.8.8;
DIB_SAMBA_METRICS_ENABLED=true
DIB_SAMBA_METRICS_PORT=9922

# Stork HTTPS and LDAPS require certificates; see docs/certificates.md for expected files and SANs.
# Defaults match the bind mounts in docker-compose.yml.
DIB_CONTROLLER_TLS_DIR=./certs/controller
DIB_STORK_SERVER_TLS_DIR=./certs/stork-server
DIB_POSTGRES_TLS_DIR=./certs/postgresql

# Bundled PostgreSQL is internal-only at 172.31.255.2 on 172.31.255.0/29.
# If that subnet overlaps your routes, change the Compose subnet, PostgreSQL
# address and STORK_DATABASE_HOST together (see docs/docker.md).
# Optional external PostgreSQL settings. External connections require verified TLS.
# DIB_STORK_DATABASE_EXTERNAL=true
# STORK_DATABASE_HOST=postgres.example.com
# STORK_DATABASE_PORT=5432
# STORK_DATABASE_NAME=stork
# STORK_DATABASE_USER_NAME=stork
# STORK_DATABASE_SSLMODE=verify-full
# STORK_DATABASE_SSLROOTCERT=/etc/stork/postgresql-tls/ca.crt
