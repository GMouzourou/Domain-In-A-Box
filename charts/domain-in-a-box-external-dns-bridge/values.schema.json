{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "realm": {"type": "string", "minLength": 1},
    "zone": {"type": "string"},
    "username": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,19}$"},
    "ownerID": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"},
    "controllers": {
      "type": "array", "minItems": 1, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["hostname", "address"],
        "properties": {
          "hostname": {"type": "string", "minLength": 1},
          "address": {"type": "string", "minLength": 1}
        }
      }
    },
    "allowedNetworks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "protectedNames": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "txtPrefix": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,29}-$"},
    "defaultTTL": {"type": "integer", "minimum": 1, "maximum": 86400},
    "watchNamespace": {"type": "string"},
    "ingressClassNames": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "credentials": {
      "type": "object", "required": ["existingSecret", "passwordKey"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "passwordKey": {"type": "string", "minLength": 1}
      }
    },
    "trust": {
      "type": "object", "required": ["existingSecret", "caKey"],
      "properties": {
        "existingSecret": {"type": "string", "minLength": 1},
        "caKey": {"type": "string", "minLength": 1}
      }
    }
  },
  "required": ["realm", "username", "ownerID", "controllers", "allowedNetworks", "credentials", "trust"]
}
